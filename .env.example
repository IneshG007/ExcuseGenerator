# Copy this file to .env and fill in your key: cp .env.example .env
# .env is gitignored. Never commit a real key.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Claude model to use (default: claude-sonnet-5-5)
MODEL=claude-sonnet-5-5

# Optional: port for the web server (default: 3000)
PORT=3000

# Optional: how hard the model thinks: low | medium | high (default: low, fastest for a party)
EFFORT=low
