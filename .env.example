# Copy this file to .env and fill in your key: cp .env.example .env
# .env is gitignored. Never commit a real key.

# Required: your free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: Gemini model to use (default: gemini-flash-latest)
MODEL=gemini-flash-latest

# Optional: port for the web server (default: 3000)
PORT=3000
